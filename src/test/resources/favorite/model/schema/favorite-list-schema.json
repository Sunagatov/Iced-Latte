{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": ["integer", "null"]
          },
          "active": {
            "type": ["boolean", "null"]
          }
        }
      },
      "required": ["id", "name", "price"]
    }
  },
  "required": ["products"]
}